# Proveedor OpenAI (por defecto)
OPENAI_API_KEY=
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Proveedor Gemini (endpoint OpenAI-compatible).
# Descomenta este bloque y comenta el de OpenAI para usar tu clave de Gemini:
# MODEL_PROVIDER=gemini
# PROVIDER_API_KEY=tu_clave_de_gemini
# PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-2.5-flash
# OPENAI_EMBEDDING_MODEL=text-embedding-004

ROUTER_STRATEGY=hybrid
SIMULAR_FALLO_TRANSITORIO_CAPACIDAD=0
