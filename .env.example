# Proveedor de modelos: openai | gemini | openai_compatible
MODEL_PROVIDER=openai

# Clave del proveedor elegido (estándar para OpenAI, Gemini u otro compatible)
PROVIDER_API_KEY=

# Opcionales: cada proveedor tiene valores por defecto
# PROVIDER_BASE_URL=    # openai: api.openai.com | gemini: generativelanguage.googleapis.com
# MODEL_NAME=           # openai: gpt-4.1-mini | gemini: gemini-2.5-flash
# EMBEDDING_MODEL=      # openai: text-embedding-3-small | gemini: text-embedding-004

ROUTER_STRATEGY=hybrid
SIMULAR_FALLO_TRANSITORIO_CAPACIDAD=0
